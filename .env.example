# Relay backend environment variables (Phase 1).
# Copy to .env for local dev. On Railway these are configured in the dashboard.

PORT=3000

# --- Claude Code (Anthropic) ---
ANTHROPIC_API_KEY=

# --- Meta Ads API ---
META_ACCESS_TOKEN=
# Run Relay business ad account (numeric; act_ prefix added automatically)
META_AD_ACCOUNT_ID=1142738370641284
# Facebook Page the ads are published under (required for the creative).
# 561230640409415 is the page associated with the Run Relay ad account.
META_PAGE_ID=561230640409415
META_APP_ID=
META_APP_SECRET=

# --- Access gate (Basic Auth) ---
# Set BOTH to require Basic Auth on every route except /health (protects the
# API and the SPA). Leave unset to disable the gate (e.g. local dev).
RELAY_BASIC_AUTH_USER=
RELAY_BASIC_AUTH_PASS=

# --- Persistence ---
# Point at a mounted Railway volume so briefs + submission records survive
# redeploys (e.g. /data/briefs.json). Unset = in-memory only (wiped on restart).
BRIEFS_DB_PATH=

# --- Google Sheets ---
# base64-encoded service-account JSON
GOOGLE_SERVICE_ACCOUNT_KEY=
ASSET_SHEET_ID=
CAMPAIGN_LOG_SHEET_ID=
